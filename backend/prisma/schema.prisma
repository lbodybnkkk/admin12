generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(200)
  brand         String   @db.VarChar(100)
  concentration String   @db.VarChar(50)
  price         Decimal  @db.Decimal(10, 2)
  stock         Int      @default(0)
  description   String?  @db.Text
  notes         String?  @db.VarChar(500)
  images        String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([brand])
  @@index([concentration])
}

model Order {
  id           Int      @id @default(autoincrement())
  firebaseKey  String?  @unique  // legacy compatibility
  orderNumber  String   @unique @default(cuid())
  fullName     String   @db.VarChar(200)
  phone        String   @db.VarChar(20)
  altPhone     String?  @db.VarChar(20)
  governorate  String   @db.VarChar(100)
  address      String   @db.Text
  items        Json
  total        Decimal  @db.Decimal(10, 2)
  status       String   @default("Under Review")
  statusAr     String   @default("قيد المراجعة")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Admin {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}